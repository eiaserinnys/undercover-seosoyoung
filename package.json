{
  "name": "undercover-seosoyoung",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4318",
    "dev:server": "NODE_OPTIONS=--no-warnings=ExperimentalWarning tsx src/server/index.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node --no-warnings=ExperimentalWarning dist/server/server/index.js",
    "test": "NODE_OPTIONS=--no-warnings=ExperimentalWarning vitest run",
    "test:watch": "NODE_OPTIONS=--no-warnings=ExperimentalWarning vitest"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.1.2",
    "@astryxdesign/theme-neutral": "^0.1.2",
    "@vitejs/plugin-react": "^4.7.0",
    "discord.js": "^14.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
